          "number": {
            "type": "integer",
            "minimum": 1
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "mimeType": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string",
