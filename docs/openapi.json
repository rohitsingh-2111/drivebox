    "responses": {
      "ApiError": {
        "description": "Consistent API error: 400 validation, 401 unauthenticated, 403 insufficient role/origin, 404 missing or inaccessible, 409 conflict, 413 upload too large, 429 rate limit, 500 unexpected server failure, 503 unavailable stored content/service, or 507 quota exceeded.",
