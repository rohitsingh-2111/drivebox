# npm run setup generates a random SESSION_SECRET and writes an ignored .env.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/drivebox?replicaSet=rs0
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_DAYS=7
# Paths resolve from the server's current working directory.
STORAGE_DIR=./storage
# Defaults: 100 MiB per account and 25 MiB maximum per uploaded file.
DEFAULT_QUOTA_BYTES=104857600
MAX_UPLOAD_BYTES=26214400
