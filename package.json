{
  "name": "drivebox",
  "version": "1.0.0",
  "private": true,
  "description": "MERN file storage with nested folders, sharing, immutable versions and trash",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @drivebox/client",
    "start": "npm run start --workspace @drivebox/server",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/unit.test.js tests/client-api.test.js tests/desktop-helpers.test.js",
    "demo": "node scripts/demo.mjs",
    "desktop": "node scripts/desktop.mjs",
    "test:desktop": "node --test tests/desktop-persistence.mjs"
  },
  "devDependencies": {
    "mongodb-memory-server": "10.2.3",
    "playwright": "1.55.0",
    "supertest": "7.1.4"
  }
}
